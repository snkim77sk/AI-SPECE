# SINSUNG G2B vNext 4.0 - Cafe24 production template
#
# IMPORTANT
# - Copy these values into Cafe24 environment settings.
# - Never commit real passwords or API keys.
# - First deployment must start with G2B_AUTO_SYNC=0.
# - G2B_TEST_MODE must stay 0 in production.

G2B_TEST_MODE=0
G2B_AUTO_SYNC=0
G2B_RUNTIME_ROLE=UNIFIED

# Required budget PostgreSQL connection.
# Example format only. Replace every placeholder in Cafe24.
G2B_BUDGET_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
G2B_BUDGET_SCHEMA=g2b_budget

# Source credentials.
# These may instead be entered after login at /settings.
G2B_SERVICE_KEY=
LOFIN_API_KEY=
EDUINFO_API_KEY=

# Operational source-cycle defaults.
G2B_SHOPPING_SYNC_INTERVAL_SECONDS=7200
G2B_SHOPPING_SYNC_DAYS_PER_RUN=31
G2B_BUDGET_SYNC_MAX_PAGES=256
G2B_BUDGET_SYNC_MAX_REQUESTS=320
G2B_OPERATIONAL_LEASE_RETRY_SECONDS=15

# Budget PostgreSQL connection/pool defaults.
G2B_BUDGET_POOL_SIZE=3
G2B_BUDGET_MAX_OVERFLOW=1
G2B_BUDGET_POOL_TIMEOUT_SECONDS=5
G2B_BUDGET_POOL_RECYCLE_SECONDS=900
G2B_BUDGET_CONNECT_TIMEOUT_SECONDS=3
G2B_BUDGET_LOCK_TIMEOUT_MS=5000
G2B_BUDGET_STATEMENT_TIMEOUT_MS=120000

# Budget retention defaults.
G2B_BUDGET_RETENTION_BATCH_SIZE=5000
G2B_BUDGET_RETENTION_DAYS=365
G2B_BUDGET_RECEIPT_RETENTION_DAYS=3

# Cafe24 control SQLite defaults.
# G2B_DB_PATH is intentionally omitted: production should use
# /app/user_data/g2b-vnext.sqlite3 automatically.
G2B_SQLITE_TIMEOUT=3
G2B_SQLITE_WAL=0

# Usually managed by Cafe24 / the process manager, so do not set unless required:
# PORT=8000
# FORWARDED_ALLOW_IPS=*

# After source-free preflight and the one-page QWGJK canary both pass,
# change this in Cafe24 and restart:
# G2B_AUTO_SYNC=1
