# SINSUNG G2B vNext 4.1 - Cafe24 production template
#
# Production storage contract:
# - one PostgreSQL database
# - g2b_app schema: CONTROL + normalized 2026-01-01+ business records + READ support
# - g2b_budget schema: normalized BUDGET current state + bounded revision/checkpoint history
# - SQLite is test-only and must not be configured in production
#
# Current 4.1.153 recovery-safe redeploy:
# Phase 0) emergency HTTP/ASGI only: keep all gates below at 0 and AUTO_SYNC_DISABLE=1
# Phase 1) full FastAPI app only: G2B_FULL_RUNTIME_ENABLE=1
# Phase 2) DB/schema only: additionally G2B_BACKEND_INIT_ENABLE=1
# Phase 3) source-free post-boot repair: additionally G2B_POST_BOOT_MAINTENANCE_ENABLE=1
# Phase 4) automatic source collection last: G2B_AUTO_SYNC=1 and G2B_AUTO_SYNC_DISABLE=0
# Existing PostgreSQL rows/revisions/checkpoints must be preserved throughout.

G2B_TEST_MODE=0
G2B_FULL_RUNTIME_ENABLE=0
G2B_BACKEND_INIT_ENABLE=0
G2B_POST_BOOT_MAINTENANCE_ENABLE=0
# Production collection is explicit opt-in from 4.1.153.
G2B_AUTO_SYNC=0
# Keep the emergency kill-switch ON until full runtime + DB + screens are verified.
G2B_AUTO_SYNC_DISABLE=1
G2B_RUNTIME_ROLE=UNIFIED
# Optional fallback deployed Git SHA. 4.1.157 prefers GITHUB_SHA, then actual .git checkout.
# This manual value is used only when neither authoritative source is available.
# If it disagrees with checkout metadata, diagnostics report build_commit_mismatch=true.
G2B_BUILD_COMMIT=

# Manual PostgreSQL connection fallback for the whole application.
# If Cafe24 already supplies DB_* system variables, keep those values unchanged and
# DO NOT add a duplicate G2B_DATABASE_URL. Use this placeholder only when platform
# PostgreSQL variables are unavailable.
G2B_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
G2B_APP_SCHEMA=g2b_app
G2B_BUDGET_SCHEMA=g2b_budget

# Current 4.1.x operation must preserve existing normalized data/checkpoints.
# Normal recovery/operation: BOTH values must remain 0.
G2B_V41_FRESH_START=0
G2B_DESTRUCTIVE_RESET_CONFIRM=0

# Shared PostgreSQL pool/timeouts.
G2B_DB_POOL_SIZE=5
G2B_DB_MAX_OVERFLOW=2
G2B_DB_POOL_TIMEOUT_SECONDS=5
G2B_DB_POOL_RECYCLE_SECONDS=900
G2B_DB_CONNECT_TIMEOUT_SECONDS=3
G2B_DB_LOCK_TIMEOUT_MS=5000
G2B_DB_STATEMENT_TIMEOUT_MS=120000

# Source credentials. These may instead be entered after login at /settings.
G2B_SERVICE_KEY=
LOFIN_API_KEY=
EDUINFO_API_KEY=

# Operational source-cycle defaults.
G2B_SHOPPING_SYNC_INTERVAL_SECONDS=7200
G2B_SHOPPING_SYNC_DAYS_PER_RUN=62
G2B_SHOPPING_RECHECK_DAYS=7
G2B_SHOPPING_LONGTAIL_RECHECK_DAYS_PER_RUN=2
G2B_SHOPPING_RETENTION_DAYS=365
G2B_SHOPPING_RETENTION_MONTHS=27
G2B_SHOPPING_RETENTION_BATCH_SIZE=2000
G2B_BUDGET_SYNC_MAX_PAGES=256
G2B_BUDGET_SYNC_MAX_REQUESTS=500
G2B_BUDGET_HISTORY_DAYS_PER_RUN=31
G2B_BUDGET_HISTORY_RESERVE_REQUESTS=20
G2B_FUTURE_BUDGET_SYNC_MAX_PAGES=24
G2B_CURRENT_APPROPRIATION_SYNC_MAX_PAGES=16
G2B_OPERATIONAL_LEASE_RETRY_SECONDS=15

# Independent source API request budgets.
# 나라장터 shopping delivery quota. This does not affect LOFIN.
G2B_VNEXT_API_DAILY_LIMIT=900
# 지방재정365 QWGJK/AIDFA quota. This does not affect 나라장터.
LOFIN_VNEXT_API_DAILY_LIMIT=500

# Budget retention: past revision history 1 year; future fiscal-year current state is protected.
G2B_BUDGET_RETENTION_BATCH_SIZE=5000
G2B_BUDGET_RETENTION_DAYS=365
G2B_BUDGET_RECEIPT_RETENTION_DAYS=3

# Usually managed by Cafe24 / the process manager:
# PORT=8000
# FORWARDED_ALLOW_IPS=*
