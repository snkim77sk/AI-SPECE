# SINSUNG G2B vNext 4.1 - Cafe24 production template
#
# Production storage contract:
# - one PostgreSQL database
# - g2b_app schema: CONTROL + normalized 2026-01-01+ business records + READ support
# - g2b_budget schema: normalized BUDGET current state + bounded revision/checkpoint history
# - SQLite is test-only and must not be configured in production
#
# Current 4.1.205 SINSUNG-style PostgreSQL-maintenance-safe redeploy:
# 1) HTTP + PostgreSQL/schema readiness come first
# 2) production UNIFIED automatic collection starts after backend readiness
#    without a manual click or positive enable flag
# 3) post-boot classification repair stays OFF unless explicitly enabled
# 4) memory-heavy source work is serialized in disposable isolated workers
# 5) keep G2B_V41_FRESH_START=0 so existing normalized data/checkpoints are preserved
# 6) second approval required for any destructive reset; normal operation MUST stay 0
G2B_DESTRUCTIVE_RESET_CONFIRM=0
# 7) on <=320 MiB UNIFIED/RESULT_SERVER cgroups, heavy work is kept out of the
#    long-lived web process; eligible source work resumes through isolated workers
# 8) 256 MiB source/manual heavy work runs in an isolated disposable worker when cgroup OOM-group allows it
# 9) default isolated worker process RSS soft limit is 112 MiB
# 4.1.236 web-first safety: <=320MiB UNIFIED web auto collection waits 300s
# after bootstrap, and forks only when child RSS + 64MiB safety reserve fits.
# This is automatic and needs no new Cafe24 env variable. A full tier may keep
# collectors in WAITING_MEMORY until memory headroom improves.
# 10) deploy and verify /live, /health and /ready; UNIFIED then resumes checkpoints automatically
# Legacy 4.0 -> 4.1 destructive migration only: temporarily set
# G2B_V41_FRESH_START=1 when the owner explicitly intends to discard old 4.0 data.

G2B_TEST_MODE=0
# Legacy compatibility flag. Production UNIFIED ignores 0 and auto-collects by
# default after backend readiness. LOCAL_COLLECTOR still requires 1 for recurrence.
G2B_AUTO_SYNC=0
# Emergency kill-switch. 1 always blocks UNIFIED automatic source work.
G2B_AUTO_SYNC_DISABLE=0
# Source-free classification repair is also opt-in.
G2B_POST_BOOT_MAINTENANCE_ENABLE=0
# Derived budget-shopping match refresh is also manual/opt-in by default.
G2B_MATCH_ROLLOVER_AUTO_ENABLE=0
# First guard: do not start new heavy work at or above this process RSS.
G2B_MEMORY_SOFT_LIMIT_MB=160
# Disposable heavy child only; keep well below the web process/container ceiling.
G2B_ISOLATED_WORKER_SOFT_LIMIT_MB=112
# Second guard is automatic and cgroup-aware. On a 256 MiB container it
# starts holding new heavy work at ~208 MiB effective pressure and marks
# hard block at ~224 MiB; a larger cgroup limit adjusts automatically.
G2B_RUNTIME_ROLE=UNIFIED
# Optional fallback deployed Git SHA when the platform does not supply GITHUB_SHA.
# If both exist, GITHUB_SHA is authoritative so a stale manual value cannot mask the build.
G2B_BUILD_COMMIT=
# Optional deployment target checks. Leave unset for normal operation.
# G2B_EXPECTED_BUILD_COMMIT=
# G2B_EXPECTED_SOURCE_FINGERPRINT=

# Manual PostgreSQL connection fallback for the whole application.
# If Cafe24 already supplies DB_* system variables, keep those values unchanged and
# DO NOT add a duplicate G2B_DATABASE_URL. Use this placeholder only when platform
# PostgreSQL variables are unavailable.
G2B_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
G2B_APP_SCHEMA=g2b_app
G2B_BUDGET_SCHEMA=g2b_budget

# Current 4.1.x operation must preserve existing normalized data/checkpoints.
# Set to 1 only for an explicitly approved legacy 4.0 -> 4.1 destructive reset.
G2B_V41_FRESH_START=0

# Shared PostgreSQL pool/timeouts.
G2B_DB_POOL_SIZE=1
G2B_DB_MAX_OVERFLOW=1
G2B_DB_POOL_TIMEOUT_SECONDS=5
G2B_DB_POOL_RECYCLE_SECONDS=900
G2B_DB_CONNECT_TIMEOUT_SECONDS=3
G2B_DB_LOCK_TIMEOUT_MS=5000
G2B_DB_STATEMENT_TIMEOUT_MS=120000

# Source credentials. These may instead be entered after login at /settings.
G2B_SERVICE_KEY=
LOFIN_API_KEY=
EDUINFO_API_KEY=

# Operational source-cycle defaults.
G2B_SHOPPING_SYNC_INTERVAL_SECONDS=7200
G2B_SHOPPING_SYNC_DAYS_PER_RUN=62
G2B_SHOPPING_RECHECK_DAYS=7
G2B_SHOPPING_LONGTAIL_RECHECK_DAYS_PER_RUN=2
G2B_SHOPPING_RETENTION_DAYS=365
G2B_SHOPPING_RETENTION_MONTHS=27
G2B_SHOPPING_RETENTION_BATCH_SIZE=2000
G2B_BUDGET_SYNC_MAX_PAGES=256
G2B_BUDGET_SYNC_MAX_REQUESTS=500
G2B_BUDGET_HISTORY_DAYS_PER_RUN=31
G2B_BUDGET_HISTORY_RESERVE_REQUESTS=20
G2B_FUTURE_BUDGET_SYNC_MAX_PAGES=24
G2B_CURRENT_APPROPRIATION_SYNC_MAX_PAGES=16
G2B_OPERATIONAL_LEASE_RETRY_SECONDS=15

# Independent source API request budgets.
# 나라장터 shopping delivery quota. This does not affect LOFIN.
G2B_VNEXT_API_DAILY_LIMIT=900
# 지방재정365 QWGJK/AIDFA quota. This does not affect 나라장터.
LOFIN_VNEXT_API_DAILY_LIMIT=500

# Budget retention: past revision history 1 year; future fiscal-year current state is protected.
G2B_BUDGET_RETENTION_BATCH_SIZE=5000
G2B_BUDGET_RETENTION_DAYS=365
G2B_BUDGET_RECEIPT_RETENTION_DAYS=3

# Usually managed by Cafe24 / the process manager:
# PORT=8000
# FORWARDED_ALLOW_IPS=*


# RESULT_SERVER compatibility only. Production default if omitted:
# G2B_SERVING_DB_PATH=/app/user_data/g2b-serving.sqlite3
